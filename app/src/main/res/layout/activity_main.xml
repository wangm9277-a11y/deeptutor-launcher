<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Draggable host: small FAB + expandable action panel -->
    <FrameLayout
        android:id="@+id/fabHost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/menuPanel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/menu_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/btnRefresh"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/menu_refresh"
                    android:src="@android:drawable/ic_popup_sync"
                    android:tint="@color/white" />

                <ImageButton
                    android:id="@+id/btnUrl"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/menu_url"
                    android:src="@android:drawable/ic_menu_mylocation"
                    android:tint="@color/white" />

                <ImageButton
                    android:id="@+id/btnImmersive"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/menu_immersive"
                    android:src="@android:drawable/ic_menu_view"
                    android:tint="@color/white" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnFab"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/fab_bg"
                android:contentDescription="@string/menu_fab"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_more"
                android:tint="@color/white" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
